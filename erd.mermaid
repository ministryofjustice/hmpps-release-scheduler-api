erDiagram
    RELEASE {
        uuid id PK "Primary Key"
        version int "Version control"
        varchar(10) person_identifier "Identifier of the person"
        varchar(32) status_code FK "References STATUS.code"
        varchar(32) reason_code FK "References REASON.code"
        date confirmed_release_date "User entered scheduled release date"
        date auto_release_date "Latest auto release date"
        date approved_release_date "Latest approved release date"
        text comments "Additional notes/comments"
        grouped_dates jsonb "Optional storage of dates used for the group dates for auto/approved"
        anchor_date_time timestamp "Can be used to identify the appropriate period of custody"
        legacy_id bigint "Reference to the legacy record in nomis"
    }

    REASON {
        varchar(32) code PK "Unique reason code"
        text description "Human-readable description of the reason"
        int sequence_number "Display order"
        boolean is_active "Whether the reason is selectable"
    }

    STATUS {
        varchar(32) code PK "Unique status code"
        text description "Human-readable description of the status"
        int sequence_number "Display order"
        boolean is_active
    }

    REASON ||--o{ RELEASE : "classifies"
    STATUS ||--o{ RELEASE : "tracks state of"